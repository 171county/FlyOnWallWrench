# Do not store real tokens in this file.
# Production deployments should use user-owned or team-owned credential storage.
HELP_ME_ENV=development
HELP_ME_DEFAULT_RETENTION=ephemeral
HELP_ME_ALLOW_PUBLIC_WRITE=false

# --- Discord read-only adapter (optional) ---
# Provide a bot token + the channel IDs you approve. When both are set, the MCP
# server and the team web app read live Discord; otherwise they use the safe
# mock feed. The browser extension always uses mock (no secrets in a browser).
# These are read at runtime and never persisted by the MCP.
HELP_ME_DISCORD_BOT_TOKEN=
HELP_ME_DISCORD_CHANNEL_IDS=

# --- Steam reviews read adapter (optional, no token needed) ---
# Comma-separated Steam app IDs whose recent reviews to read.
HELP_ME_STEAM_APP_IDS=

# --- Reddit read adapter (optional) ---
# Make a "script" app at https://www.reddit.com/prefs/apps for client id/secret.
HELP_ME_REDDIT_CLIENT_ID=
HELP_ME_REDDIT_CLIENT_SECRET=
HELP_ME_REDDIT_SUBREDDITS=
