{
  "name": "@fotw/helper",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "FOTW² local helper — a loopback bridge that lets the extension reach the local MCP wrenches. Holds no secrets; localhost-only.",
  "main": "dist/index.js",
  "bin": { "fotw-helper": "dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@help-me-comms/core": "workspace:*",
    "@help-me-comms/adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
