{
  "name": "@help-me-comms/mcp-server",
  "version": "0.1.0",
  "description": "FOTW² (Fly On The Wall) community-intelligence MCP server for game developers, modders, and community managers: scoped community evidence, drafts, and approval-gated action plans.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
