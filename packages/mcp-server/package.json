    "help-me-comms-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "mcpName": "io.github.171county/flyonwallwrench",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gamedev",
    "modding",
    "community",
    "discord",
    "reddit",
    "steam",
    "fotw",
    "mcpwrench"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/171county/FlyOnWallWrench.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/171county/FlyOnWallWrench#readme",
  "bugs": {
    "url": "https://github.com/171county/FlyOnWallWrench/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
