{
  "manifest_version": 3,
  "name": "Help Me Comms Companion",
  "description": "Ask Help Me about the visible page, selected text, or current community thread. Drafts require approval.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [],
  "action": {
    "default_title": "Help Me",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
