{
  "manifest_version": 3,
  "name": "FOTW² — Fly On The Wall",
  "description": "Ask FOTW² about the visible page, selected text, or current community thread. Drafts require approval.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs"],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://discord.com/*",
    "https://*.reddit.com/*",
    "https://*.steamcommunity.com/*",
    "https://github.com/*"
  ],
  "action": {
    "default_title": "FOTW²",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
