{
  "manifest_version": 3,
  "name": "FOTW² — Fly On The Wall",
  "description": "The cockpit for game modders & developers: community signals, cross-wrench stories, and DefWrench build intelligence in one side panel. Six themes. Drafts require approval.",
  "version": "0.2.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://discord.com/*",
    "https://*.reddit.com/*",
    "https://*.steamcommunity.com/*",
    "https://github.com/*",
    "http://127.0.0.1:7717/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "FOTW²",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
