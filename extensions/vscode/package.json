{
  "name": "help-me-comms-vscode",
  "displayName": "Help Me Comms",
  "description": "Ask Help Me about selected logs, code, config, or community evidence. Local edits require approval.",
  "version": "0.1.0",
  "publisher": "local-dev",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/171county/FlyOnWallWrench" },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": ["AI", "Other"],
  "activationEvents": [
    "onCommand:helpMe.askAboutSelection",
    "onCommand:helpMe.explainCrashLog",
    "onCommand:helpMe.createIssueDraft"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "helpMe.askAboutSelection", "title": "Help Me: Ask About Selection" },
      { "command": "helpMe.explainCrashLog", "title": "Help Me: Explain Crash Log" },
      { "command": "helpMe.createIssueDraft", "title": "Help Me: Create Issue Draft" }
    ],
    "configuration": {
      "title": "Help Me Comms",
      "properties": {
        "helpMe.sendSelectedTextOnly": {
          "type": "boolean",
          "default": true,
          "description": "Send selected text only by default."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "package:vsix": "node build.mjs && vsce package --no-dependencies --out help-me-comms.vsix",
    "test": "echo \"add vscode tests\"",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@help-me-comms/core": "workspace:*",
    "@help-me-comms/adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.99.0",
    "typescript": "^5.7.2",
    "esbuild": "^0.24.2",
    "@vscode/vsce": "^3.9.1"
  }
}
