{
  "name": "help-me-comms-vscode",
  "displayName": "Help Me Comms",
  "description": "Ask Help Me about selected logs, code, config, or community evidence. Local edits require approval.",
  "version": "0.1.0",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": ["AI", "Other"],
  "activationEvents": [
    "onCommand:helpMe.askAboutSelection",
    "onCommand:helpMe.explainCrashLog",
    "onCommand:helpMe.createIssueDraft"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "helpMe.askAboutSelection", "title": "Help Me: Ask About Selection" },
      { "command": "helpMe.explainCrashLog", "title": "Help Me: Explain Crash Log" },
      { "command": "helpMe.createIssueDraft", "title": "Help Me: Create Issue Draft" }
    ],
    "configuration": {
      "title": "Help Me Comms",
      "properties": {
        "helpMe.localAppUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Local Help Me web app URL used for demo calls."
        },
        "helpMe.sendSelectedTextOnly": {
          "type": "boolean",
          "default": true,
          "description": "Send selected text only by default."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "echo \"add vscode tests\"",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.99.0",
    "typescript": "^5.7.2"
  }
}
